# ==============================================================================
# Little Learner - Environment Variables Configuration
# ==============================================================================

# Centralized Cloud SQLite Database (Turso / LibSQL)
# ------------------------------------------------------------------------------
# Set these variables to persist child progress, stars, settings, and curriculum
# across Vercel deployments, mobile PWA, and desktop without data loss.
#
# If omitted or empty, the application automatically uses local SQLite at:
# file:data/little-learner.db
# ------------------------------------------------------------------------------
TURSO_DATABASE_URL="libsql://little-learner-youruser.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token-here"

# (Optional alternative names)
# DATABASE_URL="libsql://little-learner-youruser.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token-here"
